# Copy to .env.local for local development. Never commit real values.

# Public URL of the deployed site (used for canonical URL, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://adishamadhushanka.com.au

# Google Tag Manager container ID (public), e.g. GTM-PW295RNF. Set it only for
# Production in Vercel; leave it empty here so local development and preview
# deployments don't send analytics. GA4 is configured inside GTM, not in code.
NEXT_PUBLIC_GTM_ID=

# Resend — server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_api_key_here
# Inbox that receives contact-form messages (server-only)
CONTACT_TO_EMAIL=you@example.com

# Rate limiting (Upstash Redis). Optional locally; without these the form
# falls back to an in-memory limit. The Vercel Marketplace Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead — either pair works.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# AI chat — all server-only except NEXT_PUBLIC_TURNSTILE_SITE_KEY.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Neon pooled connection string
DATABASE_URL=
LEAD_NOTIFY_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret for hashing visitor IPs in chat logs (any long random string)
IP_HASH_SALT=
